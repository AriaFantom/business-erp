# Production environment template for docker-compose.prod.yml
# Easiest: run `./deploy.sh init` — it copies this file to .env, auto-generates
# every secret below with openssl, and prompts only for APP_URL/APP_BIND.
# Manual alternative: copy to .env yourself and fill in the marked values.
# Variables here are consumed both by the AdonisJS app (via env_file) and by
# the compose file itself for postgres/redis/minio service config.

# --- App ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
TZ=UTC

# Generate ONCE with `node ace generate:key` and never rotate (rotating
# invalidates every existing session cookie and encrypted column).
APP_KEY=

APP_NAME=Layerdreams Panel
APP_URL=https://panel.layerdreams.com

# Host interface:port where the app container publishes its port. The app is
# the ONLY service that exposes a host port. Default binds to loopback only
# (safe: reachable from the host, not the network). Set 0.0.0.0:3333 (or
# SERVER_IP:3333) to expose it on all/one interface. Anything in front of it
# (TLS, a domain, a reverse proxy) is out of scope of this stack.
APP_BIND=127.0.0.1:3333

# Session cookies are encrypted with APP_KEY. Use `database` if you ever need
# server-side invalidation; redis is not in the env enum.
SESSION_DRIVER=cookie

# When "true", the docker entrypoint runs migrations before starting the
# server. Safe to leave "true" on every boot — migration:run is idempotent.
MIGRATE=true

# When "true", the docker entrypoint runs `node ace db:seed` after migrations.
# Seeders use `updateOrCreate`, so leaving this on every boot is safe and
# guarantees the `owner`/`admin`/`member` roles + default catalog rows exist
# on a fresh database.
SEED=true

# --- Mail (Resend) ---
MAIL_MAILER=resend
MAIL_FROM_NAME=Layerdreams
MAIL_FROM_ADDRESS=no-reply@layerdreams.com
RESEND_API_KEY=

# --- Postgres (consumed by both app and the postgres service) ---
# DB_HOST MUST be `postgres` (the compose service name), not `127.0.0.1`. Inside
# the app container, `127.0.0.1` is the container itself, not the database.
DB_HOST=postgres
DB_PORT=5432
DB_USER=layerdreams
DB_PASSWORD=                            # generate a strong password
DB_DATABASE=layerdreams

# --- Redis (consumed by both app and the redis service) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                         # generate a strong password

# --- Metrics time-series (InfluxDB) ---
# Powers the dashboard/analytics charts. Set INFLUX_ENABLED=false to run
# without it (charts render empty). INFLUX_URL is fixed to http://influxdb:8086
# by docker-compose.prod.yml (internal-only service), so it is not set here.
INFLUX_ENABLED=true
# On FIRST boot only, the bundled InfluxDB runs in `setup` mode and mints
# INFLUX_TOKEN as the admin / all-access token. Keep it stable — it doubles as
# the app's token and re-initializing the volume with a different token is not
# possible. INFLUX_INIT_USERNAME/PASSWORD are the first-boot admin credentials.
INFLUX_TOKEN=                           # generate a strong admin/all-access token
INFLUX_ORG=layerdreams
INFLUX_BUCKET=metrics
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=                    # generate a strong password

# --- Storage: internal MinIO ---
# MinIO is internal storage only. It publishes no host port and is never
# reachable from the browser or public internet — all file access streams
# through the authenticated app. S3_ENDPOINT is fixed to http://minio:9000 by
# docker-compose.prod.yml, so it is not set here.
DRIVE_DISK=s3

# These are the AWS-SDK creds the app uses to talk to MinIO. Use the MinIO
# root credentials below, or create a scoped service account in the MinIO
# console and put those keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1                    # MinIO ignores the region; leave as-is
S3_BUCKET=layerdreams
S3_FORCE_PATH_STYLE=true

# MinIO root credentials. Used to bootstrap the server and (by default) the
# bucket. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY can equal these for the
# simplest setup, but a dedicated service account is recommended.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=                    # generate a strong password
