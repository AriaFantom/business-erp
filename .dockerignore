node_modules
build
tmp
# .adonisjs/ is generated, but several files are committed to git and required
# by the build: client/registry/* (Tuyau, used by Vite) and server/routes.d.ts
# (types for `response.redirect().toRoute()`). They are regenerated by
# `npm run dev`, not by `node ace build`, so we ship the committed copy.
.adonisjs
!.adonisjs/client
!.adonisjs/client/**
!.adonisjs/server
!.adonisjs/server/**
.git
.gitignore
.env
.env.*
!.env.example
.vscode
.idea
*.log
npm-debug.log*
coverage
.DS_Store
Dockerfile
.dockerignore
docker-compose*.yml
README.md
CLAUDE.md
