# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
#Mail
MAIL_MAILER=resend
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
RESEND_API_KEY=your-resend-api-key
#Storage
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=devminio
AWS_SECRET_ACCESS_KEY=devminio
AWS_REGION=us-east-1
S3_BUCKET=layerdreams
# Set when using an S3-compatible provider (MinIO, R2, etc.)
# Leave empty in production to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
#Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=dev
#Metrics time-series (InfluxDB)
INFLUX_ENABLED=true
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-influx-token
INFLUX_ORG=layerdreams
INFLUX_BUCKET=metrics