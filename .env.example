# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
#Mail
MAIL_MAILER=resend
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
RESEND_API_KEY=your-resend-api-key
#Storage
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=devminio
AWS_SECRET_ACCESS_KEY=devminio
AWS_REGION=us-east-1
S3_BUCKET=layerdreams
#Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=dev